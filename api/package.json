{
  "name": "ai-business-analyst-api",
  "version": "0.1.0",
  "private": true,
  "description": "API do AI Business Analyst: orquestra a IA (Groq, tool calling) sobre o banco de vendas fictício, só para leitura.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "verificar": "npm run lint && npm run typecheck && npm test"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
