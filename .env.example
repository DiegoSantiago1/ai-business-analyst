# Copie este arquivo para .env e defina senhas próprias.
# O .env nunca é commitado (veja .gitignore).

# ---------------------------------------------------------------- IA (Groq)
# Chave criada em https://console.groq.com (API Keys). Só a fase 4 em diante usa.
GROQ_API_KEY=
# Modelo do Groq (só modelos "production"). A cota gratuita é por modelo: desenvolver
# com o 20b e guardar o 120b para a avaliação oficial (docs/DECISOES.md D12).
GROQ_MODELO=openai/gpt-oss-20b
# Opcional: modelo reserva quando a cota do dia do principal acaba (a cota é por modelo).
# Ex.: GROQ_MODELO=openai/gpt-oss-120b e GROQ_MODELO_RESERVA=openai/gpt-oss-20b.
GROQ_MODELO_RESERVA=
# Esforço de raciocínio do gpt-oss (low, medium, high): low gasta menos tokens.
GROQ_ESFORCO=low

# ---------------------------------------------------------------- API
PORTA=3335
# Teto próprio de tokens por dia e por modelo (o provedor dá 200 mil no plano gratuito).
ORCAMENTO_DIARIO_TOKENS=150000
# Perguntas por minuto por IP (a avaliação, na mesma máquina, usa um valor maior).
LIMITE_POR_MINUTO=6

# ---------------------------------------------------------------- Banco
# Banco deste projeto, no container PostgreSQL compartilhado.
# 127.0.0.1 e não "localhost": no Windows, localhost resolve primeiro para o IPv6 ::1,
# mas o container publica a porta só em 127.0.0.1 (IPv4); cada conexão esperaria o
# timeout do ::1 antes de tentar o IPv4.
ANALISTA_DB_HOST=127.0.0.1
ANALISTA_DB_PORT=5432
ANALISTA_DB_NAME=vendas_ia
# Banco dos testes automatizados: é APAGADO e recriado a cada execução do pytest.
# Precisa ser diferente de ANALISTA_DB_NAME (a configuração recusa se forem iguais).
ANALISTA_DB_NAME_TESTE=vendas_ia_teste
# Dono dos bancos: roda as migrations e a carga. A API NUNCA usa este usuário.
ANALISTA_DB_USER=analista_dono
ANALISTA_DB_PASSWORD=troque_esta_senha

# Usuário SOMENTE LEITURA da IA: é o que a API usa. Só vê as views do schema ia.
# Criado pelo bootstrap como membro do grupo analista_leitura.
ANALISTA_IA_USER=analista_ia
ANALISTA_IA_PASSWORD=troque_esta_outra_senha

# Container e superusuário usados só pelo "python -m analista.bootstrap" (via docker
# exec, sem senha: dentro do container o psql conecta pelo socket local). O bootstrap
# se recusa a alterar um usuário que seja superusuário ou dono de bancos de outro projeto.
ANALISTA_DOCKER_CONTAINER=honda-vendas-db
ANALISTA_DOCKER_SUPERUSER=honda
